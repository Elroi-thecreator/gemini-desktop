<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h"/>
  <Extern href="vsshlids.h"/>

  <Commands package="guidGeminiPackage">
    <Groups>
      <!-- Group inside View -> Other Windows menu -->
      <Group guid="guidGeminiPackageCmdSet" id="GeminiViewGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CSCD_WINDOWS"/>
      </Group>

      <!-- Group inside Code Editor Right-Click Context Menu -->
      <Group guid="guidGeminiPackageCmdSet" id="GeminiEditorContextMenuGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN"/>
      </Group>

      <!-- Group inside Error List Right-Click Context Menu -->
      <Group guid="guidGeminiPackageCmdSet" id="GeminiErrorListContextMenuGroup" priority="0x0100">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ERRORLIST"/>
      </Group>
    </Groups>

    <Buttons>
      <!-- View -> Other Windows -> Gemini Desktop -->
      <Button guid="guidGeminiPackageCmdSet" id="cmdidGeminiToolWindowCommand" priority="0x0100" type="Button">
        <Parent guid="guidGeminiPackageCmdSet" id="GeminiViewGroup"/>
        <Strings>
          <ButtonText>Gemini Desktop</ButtonText>
        </Strings>
      </Button>

      <!-- Code Editor Context Menu: Ask Gemini -->
      <Button guid="guidGeminiPackageCmdSet" id="cmdidAskGeminiSelectionCommand" priority="0x0100" type="Button">
        <Parent guid="guidGeminiPackageCmdSet" id="GeminiEditorContextMenuGroup"/>
        <Strings>
          <ButtonText>Ask Gemini about Selection</ButtonText>
        </Strings>
      </Button>

      <!-- Code Editor Context Menu: Explain Code -->
      <Button guid="guidGeminiPackageCmdSet" id="cmdidExplainCodeCommand" priority="0x0101" type="Button">
        <Parent guid="guidGeminiPackageCmdSet" id="GeminiEditorContextMenuGroup"/>
        <Strings>
          <ButtonText>Explain Code with Gemini</ButtonText>
        </Strings>
      </Button>

      <!-- Error List Context Menu: Fix with Gemini -->
      <Button guid="guidGeminiPackageCmdSet" id="cmdidFixErrorsCommand" priority="0x0100" type="Button">
        <Parent guid="guidGeminiPackageCmdSet" id="GeminiErrorListContextMenuGroup"/>
        <Strings>
          <ButtonText>Fix Errors with Gemini</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidGeminiPackageCmdSet" id="cmdidGeminiToolWindowCommand" editor="guidVSStd97" key1="G" mod1="Control Alt"/>
    <KeyBinding guid="guidGeminiPackageCmdSet" id="cmdidAskGeminiSelectionCommand" editor="guidVSStd97" key1="A" mod1="Control Alt"/>
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidGeminiPackage" value="{a5b9e023-38cf-4821-b3b4-f06b90709b11}" />
    <GuidSymbol name="guidGeminiPackageCmdSet" value="{c94541cb-708a-4467-b501-c5ce32918452}">
      <IDSymbol name="GeminiViewGroup" value="0x1020" />
      <IDSymbol name="GeminiEditorContextMenuGroup" value="0x1030" />
      <IDSymbol name="GeminiErrorListContextMenuGroup" value="0x1040" />
      <IDSymbol name="cmdidGeminiToolWindowCommand" value="0x0100" />
      <IDSymbol name="cmdidAskGeminiSelectionCommand" value="0x0200" />
      <IDSymbol name="cmdidExplainCodeCommand" value="0x0201" />
      <IDSymbol name="cmdidFixErrorsCommand" value="0x0202" />
    </GuidSymbol>
  </Symbols>
</CommandTable>

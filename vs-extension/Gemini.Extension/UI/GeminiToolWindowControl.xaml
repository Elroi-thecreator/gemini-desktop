<UserControl x:Class="Gemini.Extension.UI.GeminiToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="400"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- WebView2 Browser Control -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Fallback / Loading Overlay -->
        <Border x:Name="LoadingOverlay" Grid.Row="0" Background="#111827" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="✨ Gemini Desktop" Foreground="#60A5FA" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="Initializing AI Pair Programmer..." Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
